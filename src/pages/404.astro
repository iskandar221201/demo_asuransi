---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Halaman Tidak Ditemukan: Budi Santoso, Agen PrimaLife"
  description="Halaman yang Anda cari tidak ditemukan. Kembali ke beranda untuk konsultasi asuransi gratis."
>
  <main
    id="konten"
    class="flex min-h-screen flex-col items-center justify-center bg-navy-50 px-4 py-16 text-center sm:px-6"
  >
    <p class="font-heading text-6xl font-semibold text-navy-950 sm:text-7xl">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-navy-950 sm:text-3xl">
      Halaman ini tidak ditemukan
    </h1>
    <p class="mt-4 max-w-md text-navy-700">
      Tautan yang Anda buka mungkin sudah dipindahkan atau salah ketik. Silakan kembali
      ke beranda untuk melanjutkan.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-md bg-wa-600 px-3 py-2 text-base font-semibold text-white transition-all duration-200 ease-fluid hover:bg-wa-700 active:scale-[0.98]"
    >
      Kembali ke beranda
    </a>
  </main>
</Layout>
