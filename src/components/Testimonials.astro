---
const testimonials = [
  {
    quote:
      "Waktu suami saya opname, proses klaimnya dibantu Pak Budi sampai selesai. Itu yang paling kami rasakan manfaatnya.",
    name: "Ibu R.",
    context: "Ibu dua anak, nasabah asuransi kesehatan",
  },
  {
    quote:
      "Saya akhirnya paham bedanya uang pertanggungan dan premi sebelum tanda tangan. Penjelasannya sabar, tanpa terburu-buru.",
    name: "Bapak D.",
    context: "Karyawan swasta, nasabah asuransi jiwa",
  },
  {
    quote:
      "Dana pendidikan anak kami sekarang punya rencana yang jelas, tidak lagi sekadar menabung seadanya.",
    name: "Ibu S.",
    context: "Wirausaha, nasabah dana pendidikan",
  },
];
---

<section id="testimoni" class="scroll-mt-24 bg-navy-50">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-3xl font-semibold text-navy-950 sm:text-4xl">Kata Nasabah</h2>
      <p class="mt-4 rounded-md border border-navy-200 bg-white px-4 py-3 text-sm text-navy-700">
        <span class="font-semibold text-navy-900">Catatan demo:</span> tiga testimoni
        berikut adalah contoh ilustrasi untuk keperluan demo, bukan pernyataan nasabah
        sungguhan.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <figure
            class="flex flex-col rounded-lg border border-navy-200 bg-white p-6"
            data-reveal
            style={`transition-delay: ${i * 100}ms`}
          >
            <blockquote class="flex-1 text-navy-800">
              <span aria-hidden="true" class="font-heading text-2xl text-navy-300">&ldquo;</span>
              {t.quote}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-navy-100 pt-4">
              <span
                aria-hidden="true"
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-100 font-heading text-sm font-semibold text-navy-800"
              >
                {t.name.replace(/^(Ibu|Bapak)\s/, "").charAt(0)}
              </span>
              <div>
                <p class="text-sm font-semibold text-navy-950">
                  {t.name} <span class="font-normal text-navy-500">(contoh)</span>
                </p>
                <p class="text-xs text-navy-600">{t.context}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
