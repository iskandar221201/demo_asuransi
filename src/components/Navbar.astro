---
import { agent, waLink } from "../data/agent.js";

const links = [
  { href: "#masalah", label: "Masalah & Solusi" },
  { href: "#produk", label: "Produk" },
  { href: "#kenapa-saya", label: "Kenapa Saya" },
  { href: "#testimoni", label: "Testimoni" },
  { href: "#faq", label: "FAQ" },
];

const ctaHref = waLink(
  "Halo Pak Budi, saya ingin konsultasi gratis tentang asuransi PrimaLife."
);
---

<div id="top" class="bg-navy-950 px-4 py-2 text-center text-xs text-navy-100 sm:px-6">
  Agen berlisensi {agent.license}
  <span class="text-navy-300">(nomor contoh untuk demo)</span>
</div>

<header class="sticky top-4 z-50 mt-6 px-4 sm:px-6">
  <nav
    aria-label="Navigasi utama"
    class="mx-auto flex w-full max-w-3xl items-center justify-between gap-4 rounded-full border border-navy-100 bg-white/80 py-2 pl-6 pr-2 shadow-sm backdrop-blur-xl lg:w-max lg:max-w-none"
  >
    <a
      href="#top"
      class="whitespace-nowrap font-heading text-lg font-semibold text-navy-950 transition-all duration-200 ease-fluid hover:text-navy-600"
    >
      {agent.shortName}
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="whitespace-nowrap text-sm font-medium text-navy-700 transition-all duration-200 ease-fluid hover:text-navy-950"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-wa-600 px-3 py-2 text-sm font-semibold whitespace-nowrap text-white transition-all duration-200 ease-fluid hover:bg-wa-700 active:scale-[0.98]"
      >
        <i class="ph ph-whatsapp-logo text-base" aria-hidden="true"></i>
        Konsultasi Gratis
      </a>
    </div>

    <button
      id="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Buka menu navigasi"
      class="group relative h-11 w-11 shrink-0 rounded-full text-navy-900 transition-all duration-200 ease-fluid hover:bg-navy-50 active:scale-[0.98] lg:hidden"
    >
      <span
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 h-0.5 w-5 -translate-x-1/2 -translate-y-1 bg-current transition-all duration-500 ease-fluid group-aria-expanded:-translate-y-1/2 group-aria-expanded:rotate-45"
      ></span>
      <span
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 h-0.5 w-5 -translate-x-1/2 translate-y-1 bg-current transition-all duration-500 ease-fluid group-aria-expanded:-translate-y-1/2 group-aria-expanded:-rotate-45"
      ></span>
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="menu-overlay fixed inset-0 z-40 flex flex-col items-center justify-center bg-white/90 backdrop-blur-3xl"
>
  <nav aria-label="Navigasi seluler" class="flex flex-col items-center gap-6 px-6 text-center">
    {
      links.map((link, i) => (
        <a
          href={link.href}
          class="menu-link font-heading text-3xl font-semibold text-navy-950"
          style={`--d: ${100 + i * 50}ms`}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={ctaHref}
      target="_blank"
      rel="noopener noreferrer"
      class="menu-link mt-4 inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-wa-600 px-3 py-2 text-base font-semibold text-white"
      style={`--d: ${100 + links.length * 50}ms`}
    >
      <i class="ph ph-whatsapp-logo text-lg" aria-hidden="true"></i>
      Konsultasi Gratis via WhatsApp
    </a>
  </nav>
</div>

<style>
  .menu-overlay {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 500ms var(--ease-fluid),
      visibility 0ms linear 500ms;
  }

  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 500ms var(--ease-fluid);
  }

  .menu-overlay .menu-link {
    transform: translateY(3rem);
    opacity: 0;
    transition:
      transform 700ms var(--ease-fluid),
      opacity 700ms var(--ease-fluid);
  }

  .menu-overlay.is-open .menu-link {
    transform: translateY(0);
    opacity: 1;
    transition-delay: var(--d, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-overlay,
    .menu-overlay .menu-link {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  function setMenu(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle("is-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute(
      "aria-label",
      open ? "Tutup menu navigasi" : "Buka menu navigasi"
    );
    document.body.style.overflow = open ? "hidden" : "";
  }

  btn?.addEventListener("click", () => {
    setMenu(btn.getAttribute("aria-expanded") !== "true");
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) setMenu(false);
  });
</script>
