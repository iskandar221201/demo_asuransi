---
import { agent } from "../data/agent.js";

const credentials = [
  "Sarjana Ekonomi (S.E.)",
  "AAAIJ, gelar profesi di bidang asuransi jiwa (contoh untuk demo)",
  `Lisensi keagenan ${agent.license} (nomor contoh untuk demo)`,
  `Terdaftar sebagai agen ${agent.company} (contoh untuk demo)`,
];

const commitments = [
  "Menjawab pesan maksimal 1x24 jam",
  "Mendampingi proses klaim dari pengumpulan dokumen sampai selesai",
  "Review polis setahun sekali, gratis untuk nasabah",
];
---

<section id="kenapa-saya" class="scroll-mt-24 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2">
      <div data-reveal>
        <h2 class="text-3xl font-semibold text-navy-950 sm:text-4xl">
          Cara Saya Bekerja dengan Calon Nasabah
        </h2>
        <p class="mt-4 text-navy-700">
          Saya percaya keputusan asuransi tidak boleh diambil karena merasa tidak enak
          menolak penawaran. Saya mulai dari memetakan kebutuhan keluarga Anda,
          menjelaskan istilah polis dengan bahasa sehari-hari, lalu memberi Anda waktu
          untuk berdiskusi dengan pasangan sebelum memutuskan.
        </p>
        <p class="mt-4 text-navy-700">
          Kalau setelah dihitung ternyata Anda belum butuh produk tertentu, saya akan
          mengatakannya. Proteksi yang benar dimulai dari kebutuhan yang benar.
        </p>

        <h3 class="mt-10 text-lg font-semibold text-navy-950">
          Komitmen layanan saya
        </h3>
        <ul class="mt-4 space-y-3">
          {
            commitments.map((c) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 bg-gold-500" />
                <span class="text-navy-700">{c}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="transition-delay: 150ms">
        <figure class="h-fit overflow-hidden rounded-lg border border-navy-200">
          <img
            src="/img/konsultasi.jpg"
            alt="Suasana konsultasi antara agen dan calon nasabah (foto ilustrasi dari Unsplash)"
            width="1200"
            height="800"
            loading="lazy"
            class="aspect-[3/2] w-full object-cover"
          />
        </figure>

        <div class="mt-6 h-fit rounded-lg border border-navy-200 bg-navy-50 p-8">
          <h3 class="text-lg font-semibold text-navy-950">Kredensial</h3>
          <ul class="mt-4 space-y-3">
            {
              credentials.map((c) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="mt-2 h-2 w-2 shrink-0 bg-navy-500" />
                  <span class="text-sm text-navy-700">{c}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 border-t border-navy-200 pt-6">
            <p class="text-sm font-semibold text-navy-950">
              Rekam jejak
              <span class="ml-1 font-normal text-navy-600">(contoh ilustrasi untuk demo)</span>
            </p>
            <div class="mt-4 grid grid-cols-2 gap-4">
              <div class="rounded-md border border-navy-200 bg-white p-4">
                <p class="font-heading text-3xl font-semibold text-navy-950">8 thn</p>
                <p class="mt-1 text-xs text-navy-600">
                  pengalaman di industri asuransi (contoh)
                </p>
              </div>
              <div class="rounded-md border border-navy-200 bg-white p-4">
                <p class="font-heading text-3xl font-semibold text-navy-950">200+</p>
                <p class="mt-1 text-xs text-navy-600">
                  keluarga terlayani (contoh ilustrasi)
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
